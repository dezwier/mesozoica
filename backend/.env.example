# Local API dev only (optional). Cron jobs do NOT use this file — they run on Railway.
#
# If you run `make run-backend` locally, point DATABASE_URL at Railway Postgres
# (public URL *.proxy.rlwy.net). Do NOT use postgres.railway.internal from your laptop.

DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:5432/railway
SECRET_KEY=your-secret-key-for-jwt-signing

# development = local API server; production = deployed Railway API
ENVIRONMENT=development

# CORS: comma-separated origins. Required in production; "*" not allowed with credentials.
CORS_ORIGINS=http://localhost:8080,https://mesozoica-production.up.railway.app

# Curated card images (local dev serves from repo dinosaur-images/ folder)
# DINOSAUR_IMAGES_DIR=../dinosaur-images
# PUBLIC_BASE_URL=https://mesozoica-production.up.railway.app
# DINOSAUR_IMAGE_SYNC_SECRET=generate-a-long-random-string

# Optional API version tag
# API_VERSION=0.1.0

# Auth (Firebase token verification on backend)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# User profile images (local dev)
# USER_IMAGES_DIR=../user-images
# PUBLIC_BASE_URL=https://mesozoica-production.up.railway.app

# --- Set these on Railway (backend + cron services), not required for local API dev ---
# WIKIPEDIA_USER_AGENT=MesozoicaBot/1.0 (https://mesozoica.app; you@example.com)
# WIKIPEDIA_DINOSAUR_CATEGORY=Category:Dinosaur_genera
# WIKIPEDIA_FEATHERED_DINOSAUR_CATEGORY=Category:Feathered dinosaurs
# WIKIPEDIA_SYNC_MAX_PAGES=20
# GOOGLE_GEMINI_API_KEY=
