# Required (production will fail without these)
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=your-secret-key-for-jwt-signing

# Environment: development | production
ENVIRONMENT=development

# CORS: comma-separated origins. Required in production; "*" not allowed with credentials.
# Examples: http://localhost:8080, https://your-app.up.railway.app
CORS_ORIGINS=*

# Optional API version tag
# API_VERSION=0.1.0

# Railway: link the PostgreSQL plugin to inject DATABASE_URL automatically.
# Set SECRET_KEY and CORS_ORIGINS in the backend service variables for production.

# Wikipedia sync (required in production for cron jobs)
# WIKIPEDIA_USER_AGENT=MesozoicaBot/1.0 (https://mesozoica.app; you@example.com)
# WIKIPEDIA_DINOSAUR_CATEGORY=Category:Dinosaur_genera
# WIKIPEDIA_BASE_URL=https://en.wikipedia.org
# WIKIPEDIA_REQUEST_DELAY_MS=200
# WIKIPEDIA_SYNC_MAX_PAGES=10
# WIKIPEDIA_SYNC_FAILURE_THRESHOLD=0.10
