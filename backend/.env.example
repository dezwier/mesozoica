# Local API dev only (optional). Cron jobs do NOT use this file — they run on Railway.
#
# If you run `make run-backend` locally, point DATABASE_URL at Railway Postgres
# (public URL *.proxy.rlwy.net). Do NOT use postgres.railway.internal from your laptop.

DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:5432/railway
SECRET_KEY=your-secret-key-for-jwt-signing

# development = local API server; production = deployed Railway API
ENVIRONMENT=development

# CORS: comma-separated origins. Required in production; "*" not allowed with credentials.
CORS_ORIGINS=http://localhost:8080,https://mesozoica-production.up.railway.app

# Curated card images (local dev serves from repo images/dinosaurs/ folder)
# DINOSAUR_IMAGES_DIR=../images/dinosaurs
# PUBLIC_BASE_URL=https://mesozoica-production.up.railway.app
# DINOSAUR_IMAGE_SYNC_SECRET=generate-a-long-random-string

# Optional API version tag
# API_VERSION=0.1.0

# Auth (Firebase token verification on backend)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# User profile images (local dev)
# USER_IMAGES_DIR=../images/users
# PUBLIC_BASE_URL=https://mesozoica-production.up.railway.app

# --- Set these on Railway (backend + worker + cron services), not required for local API dev ---
# FIELD_COORDINATE_DATA_DIR=/data
# CURATED_IMAGES_DATA_ROOT=/data
# WIKIPEDIA_USER_AGENT=MesozoicaBot/1.0 (https://mesozoica.app; you@example.com)
# WIKIPEDIA_DINOSAUR_CATEGORY=Category:Dinosaur_genera
# WIKIPEDIA_FEATHERED_DINOSAUR_CATEGORY=Category:Feathered dinosaurs
# WIKIPEDIA_SYNC_MAX_PAGES=20
# GOOGLE_GEMINI_API_KEY=

# --- Generic RAG toolkit + disabled/manual dinosaur knowledge jobs ---
# Azure OpenAI v1 endpoint, for example https://YOUR-RESOURCE.openai.azure.com/openai/v1/
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
# AZURE_SEARCH_ENDPOINT=https://YOUR-SERVICE.search.windows.net
# AZURE_SEARCH_API_KEY=
# AZURE_SEARCH_INDEX=dinosaur-knowledge
# OPENALEX_API_KEY=
# OPENALEX_MAX_WORKS=10
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=75
# RAG_CONTEXT_TOKEN_BUDGET=6000

# Optional Microsoft Foundry cloud evaluation uses Entra ID / DefaultAzureCredential.
# AZURE_AI_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
# AZURE_AI_JUDGE_MODEL=gpt-4.1
